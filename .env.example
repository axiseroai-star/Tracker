# Copy this file to .env.local and fill in the two FILL-IN values below.
# .env.local is already excluded from git by .gitignore.

# --- Notion --------------------------------------------------------------

# Internal Integration Secret from notion.so/my-integrations.
# Must have "Connect to" access on BOTH the Axisero Targets and
# Axisero Daily Log databases (see README "One-time setup").
NOTION_TOKEN=FILL-IN

# Data source IDs (Notion API 2025-09-03+ targets data sources, not database
# IDs). Already filled in — these are live and shouldn't need to change.
NOTION_TARGETS_DATA_SOURCE_ID=862d13f0-c189-48b0-8228-8c2abd6cd78e
NOTION_DAILY_LOG_DATA_SOURCE_ID=18836a07-a2e7-4eb5-8704-b9e383b6213c

# Comments data source (§13b, §16d) — feedback thread per Daily Log row.
# Must also be shared with the integration ("Connect to") like the others.
NOTION_COMMENTS_DATA_SOURCE_ID=8673e0cd-ab0b-4a34-8da2-db1dcb8c2200

# People data source (§18a) — replaces the old hardcoded PEOPLE/
# PERSON_TIMEZONES constants. Must also be shared with the integration.
NOTION_PEOPLE_DATA_SOURCE_ID=915a426e-1d90-4c2f-b02e-2fe4928ae909

# Database URLs — not secret, just used for the "Edit in Notion" link on
# /targets. NEXT_PUBLIC_ because that link is rendered client-side.
NEXT_PUBLIC_TARGETS_DATABASE_URL=https://app.notion.com/p/8fe63661efae4793ad5ded58c6587229
NEXT_PUBLIC_DAILY_LOG_DATABASE_URL=https://app.notion.com/p/6eb04c1dca1e480e9f916ce0d1059775

# --- App access (§20) -------------------------------------------------------

# No shared password lives here anymore. Every person logs in as themselves
# at /login — pick your name, then create or enter your own 4-6 digit PIN
# (bcrypt-hashed, stored on their Axisero People row as "PIN Hash"). "Is
# Admin" (a checkbox on that same row) replaces the old ADMIN_PASSWORD(S)
# mechanism entirely — Ahsan Aftab is already set to true, so there's a
# working admin from the first login. A forgotten PIN is reset from
# /admin's Team section, not from an env var.

# Signs the session cookie. Pre-generated below — regenerate any time with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it invalidates all existing sessions (forces everyone to log back in).
SESSION_SECRET=FILL-IN

# Note: there's no timezone config here at all anymore (§14, §18). Each
# person's "today" is computed from their Timezone field in the Axisero
# People database — edit it there (or via /admin's Team section) if
# someone's timezone changes, no redeploy needed.

# --- Scheduled jobs (§16e, §16g) --------------------------------------------

# Required for ALL three Vercel Cron routes (/api/cron/backup|nudge|digest) —
# Vercel sends this automatically as "Authorization: Bearer <value>" when
# CRON_SECRET is set on the project; the routes fail closed without it.
# Pre-generated below — regenerate any time with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=FILL-IN

# Weekly CSV backup email (§16e) — needs a Resend account (resend.com, free
# tier). Leave RESEND_API_KEY unset to no-op the backup job gracefully.
RESEND_API_KEY=FILL-IN
BACKUP_EMAIL_TO=FILL-IN
# Optional — defaults to Resend's shared test sender. For reliable delivery,
# verify your own domain in Resend and set a from-address on it instead.
# RESEND_FROM_EMAIL=Axisero Tracker <backups@yourdomain.com>

# Slack nudges + weekly digest (§16g) — needs a Slack Incoming Webhook
# (create a Slack App, enable Incoming Webhooks, generate a URL for the
# channel that should receive these). Leave unset to no-op both jobs.
SLACK_WEBHOOK_URL=FILL-IN

# Local hour (0-23) a nudge fires at for someone who hasn't logged yet,
# checked against their own timezone from Axisero People. Defaults to 20 (8pm).
# NUDGE_HOUR=20
